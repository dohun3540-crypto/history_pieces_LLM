{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/history_candidate.schema.json",
  "title": "Mokpo history candidate document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id", "document_id", "batch_id", "phase", "source_id", "source_url", "canonical_url", "source_title",
    "publisher", "institution", "publisher_family", "source_tier", "document_type",
    "topic_categories", "historical_period", "location", "discovered_at", "fetched_at",
    "raw_path", "raw_sha256", "extracted_path", "extracted_sha256", "normalized_body_sha256",
    "response_final_url", "response_http_status", "response_content_type",
    "extraction_status", "extraction_method", "language",
    "robots_status", "access_status", "rights_status", "license", "kogl_type",
    "rights_evidence", "provenance", "duplicate_status", "duplicate_group", "duplicate_of",
    "duplicate_method", "authority_score", "provenance_score", "historical_relevance_score",
    "mokpo_relevance_score", "corroboration_score", "content_quality_score",
    "objectivity_score", "rights_score", "uniqueness_score", "total_quality_score",
    "review_status", "acceptance_status", "rejection_reasons", "fact_conflict",
    "conflicting_values", "publication_metadata"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["A", "B", "C", "D"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string"}, "canonical_url": {"type": "string"},
    "source_title": {"type": "string"}, "publisher": {"type": "string"},
    "institution": {"type": "string"}, "publisher_family": {"type": "string"},
    "source_tier": {"enum": ["tier_1", "tier_2", "tier_3", "tier_4"]},
    "document_type": {"type": "string"},
    "topic_categories": {"type": "array", "items": {"enum": ["OPENING_TRADE", "PORT_MARITIME", "RAIL_TRANSPORT", "URBAN_INFRASTRUCTURE", "COLONIAL_CITY", "ECONOMY_FINANCE", "ARCHITECTURE_HERITAGE", "EDUCATION_RELIGION", "INDEPENDENCE_STUDENT_MOVEMENT", "LABOR_PEASANT_MOVEMENT", "PERSON_HISTORY", "POST_LIBERATION"]}},
    "historical_period": {"type": "string"}, "location": {"type": "array", "items": {"type": "string"}},
    "discovered_at": {"type": "string"}, "fetched_at": {"type": "string"},
    "raw_path": {"type": "string"}, "raw_sha256": {"type": "string"},
    "extracted_path": {"type": "string"}, "extracted_sha256": {"type": "string"},
    "normalized_body_sha256": {"type": "string"},
    "response_final_url": {"type": "string"},
    "response_http_status": {"type": "integer", "minimum": 0, "maximum": 599},
    "response_content_type": {"type": "string"},
    "extraction_status": {"type": "string"}, "extraction_method": {"type": "string"},
    "language": {"type": "string"}, "robots_status": {"type": "string"},
    "access_status": {"type": "string"}, "rights_status": {"type": "string"},
    "license": {"type": "string"}, "kogl_type": {"type": "string"},
    "rights_evidence": {"$ref": "#/$defs/rightsEvidence"}, "provenance": {"type": "object"},
    "duplicate_status": {"enum": ["unique", "suspected", "confirmed"]},
    "duplicate_group": {"type": "string"}, "duplicate_of": {"type": "string"},
    "duplicate_method": {"type": "string"},
    "authority_score": {"type": "integer", "minimum": 0, "maximum": 20},
    "provenance_score": {"type": "integer", "minimum": 0, "maximum": 15},
    "historical_relevance_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "mokpo_relevance_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "corroboration_score": {"type": "integer", "minimum": 0, "maximum": 15},
    "content_quality_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "objectivity_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "rights_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "uniqueness_score": {"type": "integer", "minimum": 0, "maximum": 10},
    "total_quality_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "review_status": {"enum": ["auto_rejected", "auto_candidate", "needs_human_review", "verified", "accepted"]},
    "acceptance_status": {"enum": ["rejected", "pending", "verified", "accepted"]},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "fact_conflict": {"type": "boolean"}, "conflicting_values": {"type": "array"},
    "publication_metadata": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {"rightsEvidence": {"type": "object", "additionalProperties": false,
    "required": ["publisher", "rights_holder", "policy_url", "document_rights_url", "license_text", "kogl_type", "commercial_use", "modification", "redistribution", "third_party_material_warning", "checked_at", "human_review_required"],
    "properties": {
      "publisher": {"type": "string"}, "rights_holder": {"type": "string"},
      "policy_url": {"type": "string"}, "document_rights_url": {"type": "string"},
      "license_text": {"type": "string"}, "kogl_type": {"type": "string"},
      "commercial_use": {"type": "string"}, "modification": {"type": "string"},
      "redistribution": {"type": "string"}, "third_party_material_warning": {"type": "boolean"},
      "checked_at": {"type": "string"}, "human_review_required": {"type": "boolean"}
    }}}
}
