# 한국관광공사 국문 관광정보 API
TOUR_API_SERVICE_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# LLM backend (development 기본값만 명시하며 비밀값은 저장하지 않음)
LLM_BACKEND=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEY_REQUIRED=false
LLM_MODEL=
LLM_MODEL_REVISION=
LLM_TIMEOUT_SECONDS=
LLM_MAX_NEW_TOKENS=
LLM_TEMPERATURE=
LLM_TOP_P=

# 선택적 운영 제한
LLM_API_FORMAT=openai
LLM_ALLOWED_HOSTS=
LLM_CONTEXT_WINDOW=
LLM_READINESS_PROBE=false

# 공공 원격 추론 서버로 보내는 context 최소화 (안전 기본값)
LLM_REMOTE_HISTORY_ENABLED=false
LLM_REMOTE_HISTORY_MAX_TURNS=1
LLM_REMOTE_CONTEXT_MAX_CHARS=12000
LLM_REMOTE_CHUNK_MAX_CHARS=1600
LLM_REMOTE_MAX_EVIDENCE_ITEMS=4
LLM_REMOTE_SANITIZE_ENABLED=true

# vLLM OpenAI-compatible server via local SSH tunnel (uncomment to use)
# HISTORY_LLM_BACKEND=openai_compatible
# HISTORY_LLM_BASE_URL=http://127.0.0.1:8001
# HISTORY_LLM_MODEL_ID=<served-model-name>
# HISTORY_LLM_API_FORMAT=openai

# Isolated GPU inference worker (set only on the GPU process; placeholders only)
GPU_LLM_MODEL_PATH=
GPU_LLM_MODEL_ID=local-llama
GPU_LLM_HOST=127.0.0.1
GPU_LLM_PORT=8001
GPU_LLM_AUTH_TOKEN=
GPU_LLM_MAX_REQUEST_BYTES=65536
GPU_LLM_MAX_MESSAGES=8
GPU_LLM_MAX_INPUT_CHARS=12000
GPU_LLM_MAX_INPUT_TOKENS=6144
GPU_LLM_MAX_NEW_TOKENS=256

# 실행 모드: development | test | hackathon | production
APP_MODE=development
